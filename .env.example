APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

# Comma-separated hosts for Sanctum SPA / Inertia cookie auth (required in production behind a real domain).
# Example: app.sekolah.test,www.sekolah.test
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# Large imports (enrollment, students) use the database queue; run a worker. See docs/background-import-queue.md
# QUEUE_CONNECTION=database

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=database,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Public endpoint untuk browser (opsional). Isi ini jika public host/port
# berbeda dengan internal REVERB_HOST/PORT (umum di Dokploy/proxy).
REVERB_PUBLIC_APP_KEY="${REVERB_APP_KEY}"
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

VITE_MIDTRANS_CLIENT_KEY="${MIDTRANS_CLIENT_KEY}"
VITE_APP_NAME="${APP_NAME}"

# Firebase Cloud Messaging
# Path ke service account JSON (absolute atau relatif ke base_path()).
# File jangan di-commit. Rekomendasi: storage/app/firebase/service-account.json
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
# Opsional: default project id (biasanya sudah ada di service account JSON)
# FIREBASE_PROJECT_ID=

# WhatsApp (API HTTP, mis. ngedeploy / wawebjs). Reminder & pembayaran terverifikasi.
# Jalankan worker: php artisan queue:work --queue=wa,default
WA_ENABLED=false
WA_API_URL=https://api-wa.ngedeploy.online/send-message
WA_API_KEY=
WA_FALLBACK_PHONE=6289502887544
# Jangan true di produksi kecuali sengaja kirim ke nomor fallback (bendahara).
WA_ALLOW_FALLBACK_RECIPIENT=false
WA_BULK_DELAY_SECONDS=12
WA_QUEUE=wa
WA_HTTP_TIMEOUT=30
